{
  "name": "@sch-hub/backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "dist/server.js",
  "engines": {
    "node": ">=20.0.0",
    "npm": ">=10.0.0"
  },
  "scripts": {
    "dev": "tsx watch --tsconfig tsconfig.json src/server.ts",
    "build": "prisma generate && tsc -p tsconfig.json && tsc-alias -p tsconfig.json",
    "start": "node dist/server.js",
    "lint": "eslint \"src/**/*.ts\"",
    "test:routes": "npm run prisma:generate && npm run build && node --experimental-vm-modules ../node_modules/jest/bin/jest.js tests/routes.test.cjs --runInBand --forceExit",
    "test:live": "node ../node_modules/jest/bin/jest.js tests/live-api.test.cjs --runInBand --forceExit --testTimeout=30000",
    "test": "jest --config tests/jest.config.ts",
    "test:unit": "jest --config tests/jest.config.ts --testPathPattern=tests/unit",
    "test:integration": "jest --config tests/jest.config.ts --testPathPattern=tests/integration",
    "test:security": "jest --config tests/jest.config.ts --testPathPattern=tests/security",
    "test:coverage": "jest --config tests/jest.config.ts --coverage",
    "test:watch": "jest --config tests/jest.config.ts --watch",
    "test:ci": "jest --config tests/jest.config.ts --ci --coverage --forceExit --detectOpenHandles",
    "test:verbose": "jest --config tests/jest.config.ts --verbose",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:deploy": "prisma migrate deploy",
    "prisma:seed": "tsx prisma/seed.ts",
    "admin": "tsx scripts/manage-super-admin.ts"
  },
  "dependencies": {
    "@asteasolutions/zod-to-openapi": "^7.3.4",
    "@aws-sdk/client-s3": "^3.1054.0",
    "@aws-sdk/s3-request-presigner": "^3.1052.0",
    "@getbrevo/brevo": "^2.1.1",
    "@google/genai": "1.10.0",
    "@prisma/engines": "^5.22.0",
    "@sentry/node": "^10.54.0",
    "bcryptjs": "^2.4.3",
    "bull": "^4.16.5",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "express-rate-limit": "^7.4.1",
    "firebase-admin": "^13.10.0",
    "groq-sdk": "^1.2.0",
    "helmet": "^8.0.0",
    "jsonwebtoken": "^9.0.2",
    "mammoth": "^1.8.0",
    "morgan": "^1.10.0",
    "multer": "^1.4.5-lts.1",
    "nanoid": "^5.1.11",
    "officeparser": "^4.1.2",
    "pdf-parse": "^2.4.5",
    "pdf-to-img": "6.2.0",
    "qrcode": "^1.5.4",
    "socket.io": "^4.8.3",
    "swagger-ui-express": "^5.0.1",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@prisma/client": "^5.22.0",
    "@types/bcryptjs": "^2.4.6",
    "@types/bull": "^3.15.9",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/geojson": "^7946.0.14",
    "@types/jest": "^29.5.14",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/morgan": "^1.9.9",
    "@types/multer": "^1.4.13",
    "@types/node": "^22.10.2",
    "@types/pdf-parse": "^1.1.5",
    "@types/qrcode": "^1.5.6",
    "@types/socket.io": "^3.0.1",
    "@types/supertest": "^7.2.1",
    "@types/swagger-ui-express": "^4.1.8",
    "eslint": "^9.17.0",
    "jest": "^29.7.0",
    "jest-junit": "^17.0.0",
    "jest-mock-extended": "^4.0.1",
    "prisma": "^5.22.0",
    "supertest": "^7.2.2",
    "ts-jest": "^29.4.12",
    "ts-node": "^10.9.2",
    "tsc-alias": "^1.8.10",
    "tsconfig-paths": "^4.2.0",
    "tsx": "^4.23.11",
    "typescript": "^5.7.2"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  }
}
