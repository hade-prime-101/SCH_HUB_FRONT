  upvoteCount Int        @default(0)
  isDeleted   Boolean    @default(false)
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  reactions   Reaction[]
  reports     Report[]

  @@index([questionId])
  @@map("answers")
}

model Reaction {
  id         String            @id @default(cuid())
  type       ReactionType
  userId     String
  user       User              @relation(fields: [userId], references: [id])
  postId     String?
  post       CommunityPost?    @relation(fields: [postId], references: [id], onDelete: Cascade)
  commentId  String?
  comment    CommunityComment? @relation(fields: [commentId], references: [id], onDelete: Cascade)
  questionId String?
  question   Question?         @relation(fields: [questionId], references: [id], onDelete: Cascade)
  answerId   String?
  answer     Answer?           @relation(fields: [answerId], references: [id], onDelete: Cascade)
  createdAt  DateTime          @default(now())

  @@unique([userId, postId, type])
  @@unique([userId, commentId, type])
  @@unique([userId, questionId, type])
  @@unique([userId, answerId, type])
  @@map("reactions")
}

model Report {
  id         String         @id @default(cuid())
  reason     ReportReason
  details    String?
  reporterId String
  reporter   User           @relation(fields: [reporterId], references: [id])
  postId     String?
  post       CommunityPost? @relation(fields: [postId], references: [id])
  questionId String?
  question   Question?      @relation(fields: [questionId], references: [id])
  answerId   String?
  answer     Answer?        @relation(fields: [answerId], references: [id])
  isResolved Boolean        @default(false)
  createdAt  DateTime       @default(now())

  @@map("reports")
}

model StudyGroup {
  id           String              @id @default(cuid())
  name         String
  description  String?
  type         StudyGroupType
  isPrivate    Boolean             @default(false)
  courseTag    String?
  departmentId String
  department   Department          @relation(fields: [departmentId], references: [id])
  createdById  String
  createdBy    User                @relation("GroupCreator", fields: [createdById], references: [id])
  memberCount  Int                 @default(1)
  isActive     Boolean             @default(true)
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt
  members      StudyGroupMember[]
  messages     StudyGroupMessage[]
  quizzes      Quiz[]
  invites      GroupInvite[]
  challengesInitiated GroupChallenge[] @relation("ChallengeInitiator")
  challengesReceived  GroupChallenge[] @relation("ChallengeReceiver")

  @@index([departmentId])
  @@index([departmentId, isActive, createdAt(sort: Desc)])
  @@map("study_groups")
}

model StudyGroupMember {
  id       String     @id @default(cuid())
  groupId  String
  group    StudyGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
  userId   String
  user     User       @relation(fields: [userId], references: [id])
  role     String     @default("MEMBER") // ADMIN, MEMBER
  joinedAt DateTime   @default(now())

  @@unique([groupId, userId])
  @@map("study_group_members")
}

model StudyGroupMessage {
  id          String     @id @default(cuid())
  groupId     String
  group       StudyGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
  senderId    String
  sender      User       @relation(fields: [senderId], references: [id])
  content     String     @db.Text
  attachments Json?
  isAiReply   Boolean    @default(false)
  aiContext   String?    @db.Text  // source attribution e.g. "based on file X by member Y"
  createdAt   DateTime   @default(now())

  @@index([groupId, createdAt(sort: Desc)])
  @@map("study_group_messages")
}

model GroupInvite {
  id        String      @id @default(cuid())
  groupId   String
  group     StudyGroup  @relation(fields: [groupId], references: [id], onDelete: Cascade)
  createdById String
  createdBy   User      @relation("InviteCreator", fields: [createdById], references: [id])
  token     String      @unique @default(cuid())
  maxUses   Int         @default(1)
  useCount  Int         @default(0)
  expiresAt DateTime?
  isRevoked Boolean     @default(false)
  createdAt DateTime    @default(now())

  @@index([groupId])
  @@map("group_invites")
}

enum ChallengeStatus {
  PENDING
  ACCEPTED
  COMPLETED
  EXPIRED
  DECLINED
}

model GroupChallenge {
  id              String          @id @default(cuid())
  initiatorGroupId String
  initiatorGroup  StudyGroup      @relation("ChallengeInitiator", fields: [initiatorGroupId], references: [id])
  receiverGroupId  String
  receiverGroup   StudyGroup      @relation("ChallengeReceiver", fields: [receiverGroupId], references: [id])
  quizId          String
  status          ChallengeStatus @default(PENDING)
  expiresAt       DateTime
  initiatorAvgScore Float?
  receiverAvgScore  Float?
  winnerGroupId   String?
  initiatorBadgeAwarded Boolean  @default(false)
  receiverBadgeAwarded  Boolean  @default(false)
  createdById     String
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  @@index([initiatorGroupId])
  @@index([receiverGroupId])
  @@map("group_challenges")
}

// ============================================================
// AUDIT LOG
// ============================================================

enum AuditAction {
  ADMIN_CREATED
  ADMIN_DELETED
  ADMIN_DEACTIVATED
  ADMIN_REACTIVATED
  ADMIN_PASSWORD_RESET
  ROLE_ASSIGNED
  COURSE_REP_NOMINATED
  USER_BLOCKED
  USER_UNBLOCKED
  MATERIAL_UPLOADED
  MATERIAL_DELETED
  MATERIAL_VERIFIED
  MATERIAL_VISIBILITY_CHANGED
  MATERIAL_REVIEW_APPROVED
  MATERIAL_REVIEW_REJECTED
  QUIZ_DELETED
  QUIZ_APPROVED
  QUIZ_REJECTED
  POST_DELETED
  LISTING_DELETED
  SHOP_DELETED
  AGENT_APPROVED
  AGENT_REJECTED
  LISTING_APPROVED
  LISTING_REJECTED
  ACCOMMODATION_APPROVED
  ACCOMMODATION_REJECTED
  SERVICE_APPROVED
  SERVICE_REJECTED
  JOB_APPROVED
  JOB_REJECTED
  REPORT_RESOLVED
  STUDY_GROUP_DELETED
  GROUP_MEMBER_KICKED
  GROUP_ROLE_CHANGED
  GROUP_CHALLENGE_CREATED
  GROUP_CHALLENGE_COMPLETED
  SCHOOL_CREATED
  SCHOOL_UPDATED
}

model AuditLog {
  id           String      @id @default(cuid())
  action       AuditAction
  performedById String
  performedBy  User        @relation("AuditPerformer", fields: [performedById], references: [id])
  targetUserId String?
  targetUser   User?       @relation("AuditTarget", fields: [targetUserId], references: [id])
  targetId     String?     // generic ref (schoolId, materialId, etc.)
  targetType   String?     // e.g. "School", "Material"
  meta         Json?       // extra context
  ipAddress    String?
  createdAt    DateTime    @default(now())

  @@index([performedById])
  @@index([action])
  @@index([createdAt(sort: Desc)])
  @@map("audit_logs")
}
