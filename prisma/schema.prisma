generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model School {
  id                String             @id @default(cuid())
  name              String
  shortCode         String             @unique
  location          String
  country           String             @default("Nigeria")
  logoUrl           String?
  isActive          Boolean            @default(true)
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  faculties         Faculty[]
  users             User[]
  events            SchoolEvent[]
  mapLocations      MapLocation[]
  campusFeatures    CampusFeature[]
  campusEntrances   CampusEntrance[]
  campusPaths       CampusPath[]
  campusRouteNodes  CampusRouteNode[]
  campusRouteEdges  CampusRouteEdge[]
  campusIndoorLevels CampusIndoorLevel[]
  campusIndoorFeatures CampusIndoorFeature[]
  campusEvents      CampusSpatialEvent[]
  campusLiveAssets  CampusLiveAsset[]
  shuttles          ShuttleRoute[]
  emergencyContacts EmergencyContact[]
  communityPosts      CommunityPost[]
  questions           Question[]
  timetableEntries    TimetableEntry[]
  accommodationPosts  AccommodationPost[]
  roommateRequests    RoommateRequest[]
  serviceListings     ServiceListing[]
  jobListings         JobListing[]
  freshersFaqs        FreshersFaq[]

  @@map("schools")
}

model Faculty {
  id          String       @id @default(cuid())
  name        String
  schoolId    String
  school      School       @relation(fields: [schoolId], references: [id])
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  departments Department[]
  users       User[]

  @@unique([name, schoolId])
  @@map("faculties")
}

model Department {
  id               String           @id @default(cuid())
  name             String
  shortCode        String
  facultyId        String
  faculty          Faculty          @relation(fields: [facultyId], references: [id])
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt
  users            User[]
  materials        Material[]
  quizzes          Quiz[]
  posts            Post[]
  reminders        DeptReminder[]
  communityPosts   CommunityPost[]
  questions        Question[]
  studyGroups      StudyGroup[]
  timetableEntries TimetableEntry[]
  courseMentors    CourseMentor[]
  events           SchoolEvent[]

  @@unique([shortCode, facultyId])
  @@map("departments")
}

model User {
  id                  String              @id @default(cuid())
  fullName            String
  email               String              @unique
  phone               String?             @unique
  matricNumber        String              @unique
  passwordHash        String
  role                UserRole            @default(STUDENT)
  level               String
  schoolId            String
  school              School              @relation(fields: [schoolId], references: [id])
  facultyId           String
  faculty             Faculty             @relation(fields: [facultyId], references: [id])
  departmentId        String
  department          Department          @relation(fields: [departmentId], references: [id])
  bio                 String?
  profilePictureUrl   String?
  fcmToken            String?
  isVerified          Boolean             @default(false)
  isActive            Boolean             @default(true)
  isDeleted           Boolean             @default(false)
  deletedAt           DateTime?
  isBlocked           Boolean             @default(false)
  blockedAt           DateTime?
  blockedById         String?
  lastSeenAt          DateTime?
  createdAt           DateTime            @default(now())
  updatedAt           DateTime            @updatedAt
  refreshTokens       RefreshToken[]
  otpCodes            OTPCode[]
  materials           Material[]          @relation("UploadedMaterials")
  ratings             MaterialRating[]
  bookmarks           Bookmark[]
  quizAttempts        QuizAttempt[]
  posts               Post[]
  comments            Comment[]
  listings            Listing[]
  shop                Shop?
  shopFollows         ShopFollow[]
  sellerRatings       SellerRating[]      @relation("RaterUser")
  receivedRatings     SellerRating[]      @relation("RatedUser")
  reminders           Reminder[]
  plannerEntries      PlannerEntry[]
  timetableEntries    TimetableEntry[]    @relation("TimetableCreator")
  personalTimetable   TimetableEntry[]    @relation()
  eventsCreated       SchoolEvent[]       @relation("EventCreator")
  eventTickets        EventTicket[]       @relation()
  ticketsApproved     EventTicket[]       @relation("TicketApprover")
  eventReminders      EventReminder[]
  mapLocationsCreated MapLocation[]       @relation("MapLocationCreator")
  emergencyContacts   EmergencyContact[]  @relation("EmergencyContactCreator")
  aiSummaryRequests   AISummaryRequest[]
  personalStudySessions PersonalStudySession[]
  lostFoundItems          LostFoundItem[]
  agentProfile            AgentProfile?
  marketplaceReports      MarketplaceReport[]    @relation("ReportedBy")
  savedListings           SavedListing[]
  accommodationPosts      AccommodationPost[]  @relation("AccommodationPoster")
  roommateRequests        RoommateRequest[]    @relation("RoommateRequester")
  serviceListings         ServiceListing[]     @relation("ServiceProvider")
  jobListings             JobListing[]         @relation("JobPoster")
  notifications           Notification[]
  settings            UserSettings?
  cgpaCourses         CGPACourse[]
  cgpaRecords         CGPARecord[]
  communityPosts      CommunityPost[]
  communityComments   CommunityComment[]
  communityBookmarks  CommunityBookmark[]
  academicPostCount   Int                 @default(0)
  courseMentors       CourseMentor[]
  questions           Question[]
  answers             Answer[]
  reactions           Reaction[]
  reports             Report[]
  studyGroupsCreated  StudyGroup[]        @relation("GroupCreator")
  studyGroupMembers   StudyGroupMember[]
  studyGroupMessages  StudyGroupMessage[]
  groupInvitesCreated GroupInvite[]       @relation("InviteCreator")
  quizAnalytics       QuizAnalytics?
  auditLogsPerformed  AuditLog[]          @relation("AuditPerformer")
  auditLogsReceived   AuditLog[]          @relation("AuditTarget")
  agentProfilesReviewed AgentProfile[]    @relation("AgentReviewer")

  @@index([schoolId, departmentId, level])
  @@index([email])
  @@map("users")
}

enum UserRole {
  STUDENT
  COURSE_REP
  AUTHORIZED_UPLOADER
  EVENT_ORCHESTRATOR
  HOUSE_AGENT
  SCHOOL_ADMIN
  SUPER_ADMIN
}

model RefreshToken {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  token      String   @unique
  expiresAt  DateTime
  deviceInfo String?
  createdAt  DateTime @default(now())

  @@index([userId])
  @@map("refresh_tokens")
}

model OTPCode {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  code      String
  type      OTPType
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId, type])
  @@map("otp_codes")
}

enum OTPType {
  EMAIL_VERIFICATION
  PASSWORD_RESET
}

model UserSettings {
  id                   String   @id @default(cuid())
  userId               String   @unique
  user                 User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  darkMode             Boolean  @default(false)
  lowDataMode          Boolean  @default(false)
  notificationsEnabled Boolean  @default(true)
  emailNotifications   Boolean  @default(true)
  pushNotifications    Boolean  @default(true)
  reminderPush         Boolean  @default(true)
  eventPush            Boolean  @default(true)
  whatsappOptIn        Boolean  @default(false)
  announcementPush     Boolean  @default(true)
  quietHoursEnabled    Boolean  @default(false)
  quietHoursStart      String   @default("22:00") // HH:MM
  quietHoursEnd        String   @default("07:00") // HH:MM
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  @@map("user_settings")
}

model Material {
  id                String             @id @default(cuid())
  title             String
  type              MaterialType
  courseCode        String
  courseTitle       String
  year              Int?
  level             String?
  description       String?
  fileUrl           String
  fileKey           String
  fileSize          Int
  mimeType          String
  contentHash            String?
  extractedText          String?            @db.Text
  extractedTextPreview   String?            @db.Text
  textExtractionStatus   TextExtractionStatus @default(PENDING)
  isVerified             Boolean            @default(false)
  verifiedAt             DateTime?
  verifiedById           String?
  reviewStatus           MaterialReviewStatus @default(APPROVED)
  reviewedAt             DateTime?
  reviewedById           String?
  reviewNote             String?
  uploadedById           String
  uploadedBy             User               @relation("UploadedMaterials", fields: [uploadedById], references: [id])
  departmentId           String
  department             Department         @relation(fields: [departmentId], references: [id])
  downloadCount          Int                @default(0)
  viewCount              Int                @default(0)
  avgRating              Float              @default(0)
  visibility             MaterialVisibility @default(PUBLIC)
  studyGroupId           String?
  isDeleted              Boolean            @default(false)
  deletedAt              DateTime?
  createdAt              DateTime           @default(now())
  updatedAt              DateTime           @updatedAt
  ratings                MaterialRating[]
  bookmarks              Bookmark[]
  aiSummary              AISummary?
  aiSummaryRequests      AISummaryRequest[]
  personalStudySessions  PersonalStudySession[]

  @@index([departmentId, type, level])
  @@index([departmentId, visibility, isDeleted, createdAt(sort: Desc)])
  @@index([reviewStatus, isDeleted])
  @@index([courseCode])
  @@index([uploadedById])
  @@map("materials")
}

enum MaterialReviewStatus {
  PENDING_REVIEW
  APPROVED
  REJECTED
}

enum TextExtractionStatus {
  PENDING
  READABLE
  EMPTY
}

enum MaterialType {
  PAST_QUESTION
  NOTE
  HANDOUT
  ASSIGNMENT
  SUMMARY
  SLIDES
  OTHER
}

enum MaterialVisibility {
  PUBLIC
  DEPARTMENT
  LEVEL
  STUDY_GROUP
  PRIVATE
}

model MaterialRating {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id])
  materialId String
  material   Material @relation(fields: [materialId], references: [id])
  rating     Int
  createdAt  DateTime @default(now())

  @@unique([userId, materialId])
  @@map("material_ratings")
}

model Bookmark {
  id         String       @id @default(cuid())
  userId     String
  user       User         @relation(fields: [userId], references: [id])
  materialId String?
  material   Material?    @relation(fields: [materialId], references: [id])
  postId     String?
  post       Post?        @relation(fields: [postId], references: [id])
  type       BookmarkType
  createdAt  DateTime     @default(now())

  @@unique([userId, materialId])
  @@unique([userId, postId])
  @@map("bookmarks")
}

enum BookmarkType {
  MATERIAL
  POST
}

model AISummary {
  id                    String           @id @default(cuid())
  materialId            String           @unique
  material              Material         @relation(fields: [materialId], references: [id])
  status                AISummaryStatus  @default(PENDING)
  progress              Int              @default(0)
  totalChunks           Int              @default(0)
  processedChunks       Int              @default(0)
  shortSummary          String?          @db.Text
  keyPoints             Json?
  likelyExamTopics      Json?
  simplifiedExplanation String?          @db.Text
  finalSummary          String?          @db.Text
  combinedKeyPoints     Json?
  combinedExamTopics    Json?
  revisionSheet         String?          @db.Text
  revisionRoadmap       Json?            // Array of { step, topic, description, estimatedMinutes }
  quizApprovalStatus    QuizApprovalStatus @default(PENDING_REVIEW)
  masterQuizId          String?
  processingTimeMs      Int?
  errorMessage          String?
  createdAt             DateTime         @default(now())
  updatedAt             DateTime         @updatedAt
  chunks                AISummaryChunk[]

  @@map("ai_summaries")
}

model AISummaryChunk {
  id                  String          @id @default(cuid())
  aiSummaryId         String
  aiSummary           AISummary       @relation(fields: [aiSummaryId], references: [id], onDelete: Cascade)
  chunkNumber         Int
  summary             String?         @db.Text
  keyPoints           Json?
  examTopics          Json?
  quizQuestions       Json?
  beginnerExplanation String?         @db.Text
  status              AISummaryStatus @default(PENDING)
  createdAt           DateTime        @default(now())

  @@unique([aiSummaryId, chunkNumber])
  @@map("ai_summary_chunks")
}

model AISummaryRequest {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id])
  materialId String
  material   Material @relation(fields: [materialId], references: [id])
  createdAt  DateTime @default(now())

  @@map("ai_summary_requests")
}

// ── Personal Study Workspace ──────────────────────────────────────────────
// A private space where any student can upload a file or pin an existing
// material and then generate personalised quizzes / ask AI questions.

model PersonalStudySession {
  id          String                       @id @default(cuid())
  userId      String
  user        User                         @relation(fields: [userId], references: [id])
  // Either points to a platform material or owns a private upload
  materialId  String?
  material    Material?                    @relation(fields: [materialId], references: [id])
  // For private uploads not in the main material catalogue
  privateFileUrl  String?
  privateFileKey  String?
  privateFileSize Int?
  privateMimeType String?
  privateFileName String?
  extractedText   String?                  @db.Text
  title           String
  courseCode      String
  createdAt   DateTime                     @default(now())
  updatedAt   DateTime                     @updatedAt
  questions   PersonalQuizQuestion[]
  chatHistory PersonalStudyChat[]

  @@index([userId, createdAt(sort: Desc)])
  @@map("personal_study_sessions")
}

model PersonalQuizQuestion {
  id            String               @id @default(cuid())
  sessionId     String
  session       PersonalStudySession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  question      String
  options       Json                 // string[]
  correctAnswer Int
  explanation   String?
  topic         String?
  order         Int
  createdAt     DateTime             @default(now())

  @@index([sessionId])
  @@map("personal_quiz_questions")
}

model PersonalStudyChat {
  id        String               @id @default(cuid())
  sessionId String
  session   PersonalStudySession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  role      PersonalChatRole
  content   String               @db.Text
  createdAt DateTime             @default(now())

  @@index([sessionId, createdAt(sort: Asc)])
  @@map("personal_study_chats")
}

enum PersonalChatRole {
  USER
  ASSISTANT
}


enum AISummaryStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
}

enum QuizApprovalStatus {
  PENDING_REVIEW
  APPROVED
  REJECTED
}

enum QuizVisibility {
  PUBLIC
  DEPARTMENT
  LEVEL
  STUDY_GROUP
  PRIVATE
}

model Quiz {
  id           String         @id @default(cuid())
  title        String
  courseCode   String
  description  String?
  level        String?
  timeLimit    Int
  departmentId String
  department   Department     @relation(fields: [departmentId], references: [id])
  createdById  String
  creatorRole  String         @default("COURSE_REP")
  visibility   QuizVisibility @default(DEPARTMENT)
  studyGroupId String?
  studyGroup   StudyGroup?    @relation(fields: [studyGroupId], references: [id], onDelete: SetNull)
  isAiGenerated      Boolean        @default(false)
  isDraft            Boolean        @default(false)
  quizApprovalStatus QuizApprovalStatus @default(APPROVED) // manual quizzes auto-approved
  isActive           Boolean        @default(true)
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt
  questions    QuizQuestion[]
  attempts     QuizAttempt[]
  questionStats QuizQuestionStat[]

  @@index([departmentId, courseCode])
  @@index([departmentId, visibility, isDraft, isActive, createdAt(sort: Desc)])
  @@index([studyGroupId])
  @@map("quizzes")
}

model QuizQuestion {
  id            String   @id @default(cuid())
  quizId        String
  quiz          Quiz     @relation(fields: [quizId], references: [id], onDelete: Cascade)
  question      String   @db.Text
  options       Json
  correctAnswer Int
  explanation   String?  @db.Text
  order         Int
  createdAt     DateTime @default(now())

  @@index([quizId])
  @@map("quiz_questions")
}

model QuizAttempt {
  id             String   @id @default(cuid())
  userId         String
  user           User     @relation(fields: [userId], references: [id])
  quizId         String
  quiz           Quiz     @relation(fields: [quizId], references: [id])
  score          Int
  totalQuestions Int
  percentage     Float
  timeTaken      Int
  answers        Json     // Array of { questionId, selected, correct, topic? }
  completedAt    DateTime @default(now())

  @@index([userId, quizId])
  @@index([quizId, completedAt(sort: Desc)])
  @@map("quiz_attempts")
}

// Per-user quiz analytics profile
model QuizAnalytics {
  id               String   @id @default(cuid())
  userId           String   @unique
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  totalAttempts    Int      @default(0)
  totalCorrect     Int      @default(0)
  totalQuestions   Int      @default(0)
  weakTopics       Json     @default("[]")  // string[]
  topicAttempts    Json     @default("{}")  // { [topic]: { attempts, wrong } }
  updatedAt        DateTime @updatedAt

  @@map("quiz_analytics")
}

// Per-question aggregate stats (updated on every attempt)
model QuizQuestionStat {
  id             String @id @default(cuid())
  quizId         String
  quiz           Quiz   @relation(fields: [quizId], references: [id], onDelete: Cascade)
  questionId     String @unique
  topic          String @default("General")
  totalAttempts  Int    @default(0)
  totalWrong     Int    @default(0)

  @@index([quizId])
  @@map("quiz_question_stats")
}

enum TimetableType {
  PERSONAL
  DEPARTMENTAL
  GENERAL
}

enum ClassType {
  LECTURE
  PRACTICAL
  SEMINAR
  EXAM
  TEST
}

model TimetableEntry {
  id            String        @id @default(cuid())
  timetableType TimetableType @default(PERSONAL)
  courseCode    String
  courseTitle   String
  venue         String?
  dayOfWeek     Int
  startTime     String
  endTime       String
  type          ClassType     @default(LECTURE)
  isRecurring   Boolean       @default(true)
  level         String? // for DEPARTMENTAL — e.g. "300"
  userId        String? // only for PERSONAL
  user          User?         @relation(fields: [userId], references: [id])
  departmentId  String? // only for DEPARTMENTAL
  department    Department?   @relation(fields: [departmentId], references: [id])
  schoolId      String? // only for GENERAL
  school        School?       @relation(fields: [schoolId], references: [id])
  createdById   String
  createdBy     User          @relation("TimetableCreator", fields: [createdById], references: [id])
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  @@index([userId])
  @@index([departmentId, level])
  @@index([schoolId])
  @@map("timetable_entries")
}

model SchoolEvent {
  id             String          @id @default(cuid())
  title          String
  description    String?         @db.Text
  type           EventType
  startDate      DateTime
  endDate        DateTime?
  venue          String?
  imageUrl       String?
  schoolId       String
  school         School          @relation(fields: [schoolId], references: [id])
  departmentId   String?
  department     Department?     @relation(fields: [departmentId], references: [id])
  level          String?
  createdById    String
  createdBy      User            @relation("EventCreator", fields: [createdById], references: [id])
  isActive       Boolean         @default(true)
  requiresTicket Boolean         @default(false)
  ticketPrice    Decimal?        @db.Decimal(10, 2)
  bankName       String?
  accountNumber  String?
  accountName    String?
  totalTickets   Int?
  ticketsSold    Int             @default(0)
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  tickets        EventTicket[]
  eventReminders EventReminder[]

  @@index([schoolId, startDate])
  @@index([departmentId, level, startDate])
  @@map("school_events")
}

enum EventType {
  INFO_ONLY
  EXAM
  DEPARTMENTAL
  SEMINAR
  PROGRAM
  DEADLINE
  HOLIDAY
  OTHER
}

enum MapLocationType {
  BUILDING
  HOSTEL
  CAFETERIA
  LIBRARY
  CLINIC
  SPORTS
  GATE
  PARKING
  OFFICE
  LAB
  LECTURE_HALL
  OTHER
  UNKNOWN
}

model MapLocation {
  id          String          @id @default(cuid())
  name        String
  type        MapLocationType @default(UNKNOWN)
  description String?
  latitude    Float
  longitude   Float
  floor       String?
  tags        Json? // String[]
  schoolId    String
  school      School   @relation(fields: [schoolId], references: [id])
  imageUrl    String?
  createdById String
  createdBy   User     @relation("MapLocationCreator", fields: [createdById], references: [id])
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([schoolId])
  @@map("map_locations")
}

enum CampusFeatureCategory {
  BUILDING
  HOSTEL
  LECTURE_HALL
  LIBRARY
  CLINIC
  CAFETERIA
  ATM
  SPORTS
  SHUTTLE_STOP
  GATE
  PARKING
  LANDMARK
  OFFICE
  LAB
  ROAD
  PATH
  OTHER
}

enum CampusEntranceKind {
  MAIN
  ACCESSIBLE
  SERVICE
  EMERGENCY
  SECONDARY
}

enum CampusRouteMode {
  WALKING
  ACCESSIBLE
}

enum CampusLiveAssetType {
  SHUTTLE
  CROWD_HEATMAP
  EMERGENCY
  SENSOR
}

model CampusFeature {
  id            String                @id
  schoolId      String
  school        School                @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  category      CampusFeatureCategory @default(OTHER)
  name          String
  description   String?
  aliases       Json                  @default("[]")
  tags          Json                  @default("[]")
  metadata      Json                  @default("{}")
  images        Json                  @default("[]")
  routing       Json                  @default("{\"routable\":true}")
  accessibility Json                  @default("{\"wheelchair\":false,\"stepFree\":false,\"ramp\":false}")
  importance    Int                   @default(0)
  isActive      Boolean               @default(true)
  geometry      Unsupported("geometry")
  centroid      Unsupported("geometry")?
  entrances     CampusEntrance[]
  routeNodes    CampusRouteNode[]
  indoorLevels  CampusIndoorLevel[]
  createdAt     DateTime              @default(now())
  updatedAt     DateTime              @updatedAt

  @@index([schoolId, category, isActive])
  @@map("campus_features")
}

model CampusEntrance {
  id           String             @id
  schoolId     String
  school       School             @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  featureId    String?
  feature      CampusFeature?     @relation(fields: [featureId], references: [id], onDelete: Cascade)
  kind         CampusEntranceKind @default(SECONDARY)
  name         String?
  priority     Int                @default(50)
  isAccessible Boolean            @default(false)
  metadata     Json               @default("{}")
  geometry     Unsupported("geometry")
  routeNodes   CampusRouteNode[]
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt

  @@index([featureId, priority])
  @@map("campus_entrances")
}

model CampusPath {
  id           String             @id
  schoolId     String
  school       School             @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  name         String?
  kind         String             @default("walkway")
  isAccessible Boolean            @default(true)
  metadata     Json               @default("{}")
  geometry     Unsupported("geometry")
  routeEdges   CampusRouteEdge[]
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt

  @@map("campus_paths")
}

model CampusRouteNode {
  id         String             @id
  schoolId   String
  school     School             @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  featureId  String?
  feature    CampusFeature?     @relation(fields: [featureId], references: [id], onDelete: SetNull)
  entranceId String?
  entrance   CampusEntrance?    @relation(fields: [entranceId], references: [id], onDelete: SetNull)
  metadata   Json               @default("{}")
  geometry   Unsupported("geometry")
  fromEdges  CampusRouteEdge[]  @relation("RouteEdgeFromNode")
  toEdges    CampusRouteEdge[]  @relation("RouteEdgeToNode")

  @@map("campus_route_nodes")
}

model CampusRouteEdge {
  id             String            @id
  schoolId       String
  school         School            @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  fromNodeId     String
  fromNode       CampusRouteNode   @relation("RouteEdgeFromNode", fields: [fromNodeId], references: [id], onDelete: Cascade)
  toNodeId       String
  toNode         CampusRouteNode   @relation("RouteEdgeToNode", fields: [toNodeId], references: [id], onDelete: Cascade)
  pathId         String?
  path           CampusPath?       @relation(fields: [pathId], references: [id], onDelete: SetNull)
  distanceMeters Float
  isAccessible   Boolean           @default(true)
  slope          Float?
