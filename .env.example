NODE_ENV=development
PORT=3000

# ── Database (Supabase Postgres) ──────────────────────────────────────────
# Supabase Postgres has PostGIS pre-installed — required by the campus map module.
# Find these at: Supabase → Project Settings → Database → Connection string
#
# DATABASE_URL  — use the "Transaction" pooler (port 6543) for the app server.
# DIRECT_URL    — use the "Session" / direct connection (port 5432) for migrations.
#
# Format: postgresql://postgres.[ref]:[password]@aws-0-[region].pooler.supabase.com:[port]/postgres
DATABASE_URL=postgresql://postgres.[ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres?pgbouncer=true
DIRECT_URL=postgresql://postgres.[ref]:[password]@aws-0-[region].pooler.supabase.com:5432/postgres

# ── Auth ──────────────────────────────────────────────────────────────────
JWT_ACCESS_SECRET=replace-with-a-long-random-access-secret-min-32-chars
JWT_REFRESH_SECRET=replace-with-a-long-random-refresh-secret-min-32-chars
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL_DAYS=30

CORS_ORIGIN=http://localhost:8081

# ── Redis (required — used by Bull job queues) ────────────────────────────
REDIS_URL=redis://localhost:6379

# ── Supabase Storage ──────────────────────────────────────────────────────
# Enable S3 access in: Supabase dashboard → Project Settings → Storage → S3 Access
# Then copy the endpoint, region, access key, and secret key shown there.
# Leave all four blank locally — files will be saved to ./uploads/ instead.
SUPABASE_S3_ENDPOINT=
SUPABASE_S3_REGION=
SUPABASE_S3_ACCESS_KEY=
SUPABASE_S3_SECRET_KEY=
SUPABASE_STORAGE_BUCKET=sch-hub
# Public URL for public buckets (optional).
# Format: https://<project_ref>.storage.supabase.co/storage/v1/object/public/<bucket>
# Leave blank to use presigned download URLs instead.
SUPABASE_PUBLIC_URL=

# ── Brevo Email ───────────────────────────────────────────────────────────
# Leave blank locally — emails are printed to the console instead.
# Get API key at: https://app.brevo.com → Settings → API Keys
BREVO_API_KEY=
BREVO_SENDER_EMAIL=no-reply@sch-hub.app
BREVO_SENDER_NAME=SCH Hub

# ── Firebase Admin (FCM push notifications) ───────────────────────────────
# Leave blank locally — FCM calls are stubbed to console.log.
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
# Paste the private key with literal \n characters (not real newlines).
# The app does .replace(/\\n/g, '\n') internally.
FIREBASE_PRIVATE_KEY=

# ── Sentry (error tracking) ───────────────────────────────────────────────
SENTRY_DSN=

# ── AI providers ──────────────────────────────────────────────────────────
# ── Text completion (chat / summary / quiz) ───────────────────────────────

# Primary: Groq — fast inference, generous free tier
# Get key at: https://console.groq.com/keys
GROQ_API_KEY=

# Text fallback 1: OpenRouter — 300+ models, OpenAI-compatible API
# Get key at: https://openrouter.ai/keys
# Activated automatically if Groq is unavailable or not configured.
OPENROUTER_API_KEY=
# Override the default fallback model (default: meta-llama/llama-3.3-70b-instruct:free)
# Full model list: https://openrouter.ai/models
OPENROUTER_MODEL=

# Text fallback 2: DeepSeek — cost-effective, strong reasoning, OpenAI-compatible
# Get key at: https://platform.deepseek.com/api_keys
# Activated if both Groq and OpenRouter are unavailable or not configured.
DEEPSEEK_API_KEY=
# Override default DeepSeek model (default: deepseek-chat)
# Options: deepseek-chat | deepseek-reasoner
DEEPSEEK_MODEL=

# ── OCR — scanned PDF text extraction ────────────────────────────────────
# Primary OCR: Groq Vision — reuses GROQ_API_KEY above, no extra key needed.
#
# Fallback OCR: Gemini Vision
# Get key at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=
# Override default Gemini model (default: gemini-2.0-flash)
GEMINI_MODEL=

# ── Campus Map ────────────────────────────────────────────────────────────
# OpenRouteService — free key at https://openrouteservice.org/dev/#/signup
ORS_API_KEY=
# MapTiler — free key at https://cloud.maptiler.com/account/keys/
MAPTILER_API_KEY=

# ── WhatsApp broadcast ────────────────────────────────────────────────────
# provider: fonnte | twilio | wati  (leave blank to disable)
WHATSAPP_PROVIDER=

# Fonnte — recommended open-source friendly option.
# Connect your own WhatsApp number via QR scan at https://fonnte.com
# then copy the device token from the dashboard.
FONNTE_TOKEN=

# Twilio WhatsApp (legacy alternative)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=

# WATI (legacy alternative)
WATI_API_URL=
WATI_API_TOKEN=

# ── Single-school mode ────────────────────────────────────────────────────
# After running prisma:seed, grab the school cuid from the DB and paste it here.
# The /school/schools endpoint will return only this school.
# Leave blank to show all schools (multi-school mode).
SCHOOL_ID=
